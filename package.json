{
  "name": "shiguang-isle",
  "version": "1.3.7",
  "description": "时光杂货店 · 摄影回忆时光机 — a local-first DSLR photo library",
  "main": "app/main.cjs",
  "author": "Shiguang Isle contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test tests/*.test.cjs",
    "privacy": "node scripts/privacy-check.cjs",
    "icon": "node scripts/icon.cjs",
    "build:mac": "electron-builder --mac dmg zip --publish never",
    "build:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "exiftool-vendored": "39.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.shiguang.isle",
    "productName": "Shiguang Isle",
    "artifactName": "Shiguang-Isle-${version}-${os}-${arch}.${ext}",
    "files": [
      "app/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "docs/architecture.md"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/exiftool-vendored.pl/**/*",
      "node_modules/exiftool-vendored.exe/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.photography",
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "executableName": "shiguang-isle",
      "category": "Graphics;Photography",
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Shiguang Isle contributors"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libasound2",
        "libatk1.0-0",
        "libatk-bridge2.0-0",
        "libdrm2",
        "libgbm1",
        "libxkbcommon0",
        "libx11-xcb1",
        "libxss1",
        "libxshmfence1",
        "xdg-utils",
        "perl"
      ]
    }
  }
}
